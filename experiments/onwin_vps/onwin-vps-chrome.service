[Unit]
Description=Onwin visible Chrome on its TigerVNC desktop
After=network.target

[Service]
Type=simple
User=woundedlion
WorkingDirectory=/home/woundedlion/apps/ArbScanner
Environment=ONWIN_VPS_CDP_PORT=9223
EnvironmentFile=-/home/woundedlion/apps/ArbScanner/experiments/onwin_vps/config.env
ExecStart=/home/woundedlion/apps/ArbScanner/experiments/onwin_vps/chrome.sh foreground
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
