# Dedicated Onwin Chrome on the VPS. Copy to config.env and edit there.
# config.env is gitignored. Do not put this on port 9222.

ONWIN_VPS_CDP_PORT=9223
ONWIN_VPS_DISPLAY=:1
ONWIN_VPS_PUBLISH=0

# Used only when ONWIN_VPS_PUBLISH=1. Keep the Windows collector stopped first.
# ONWIN_INGEST_TOKEN=
# ONWIN_INGEST_URL=https://api.lintonbeautynrb.org/onwin/live
# ONWIN_PREMATCH_INGEST_URL=https://api.lintonbeautynrb.org/onwin/prematch
