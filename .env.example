# ============================================================
# ArbScanner environment configuration template.
#
# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored -- never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Credential management (see docs/CREDENTIALS.md)
# ------------------------------------------------------------

# Master encryption key used to encrypt/decrypt credentials.json.
# Generate one with:
#   .venv\Scripts\python.exe -m credentials.cli init
# NEVER commit this value. Anyone with this key can decrypt every
# credential in the encrypted store.
MASTER_CREDENTIAL_KEY=

# ------------------------------------------------------------
# ZenRows -- legacy single-credential fallback (optional)
#
# If MASTER_CREDENTIAL_KEY + credentials.json are set up, ZenRows
# credentials should be added via:
#   .venv\Scripts\python.exe -m credentials.cli add --provider zenrows --secret "wss://browser.zenrows.com?apikey=YOUR_KEY"
#
# This variable is kept as a zero-config fallback: if no zenrows
# credentials exist in the encrypted store, this single value is used
# instead so existing setups keep working without migrating.
# ------------------------------------------------------------
ZENROWS_BROWSER_WS=wss://browser.zenrows.com?apikey=YOUR_ZENROWS_API_KEY

# ------------------------------------------------------------
# Other providers referenced by experimental/legacy browser sessions.
# Not required for the current live ZenRows-based pipeline.
# ------------------------------------------------------------
SCRAPFLY_API_KEY=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# ------------------------------------------------------------
# Engine / worker tuning (all optional -- sane defaults exist)
# ------------------------------------------------------------

# Seconds after which an odds snapshot is treated as stale.
MAX_ODDS_AGE_SECONDS=30

# Arbitrage engine tick interval, in seconds.
ENGINE_TICK_SECONDS=1

# BetKanyon LIVE polling interval, in seconds.
BETKANYON_LIVE_POLL_INTERVAL=5
BETKANYON_POLL_INTERVAL=5

# Old Windows ~10-minute forced worker restart. 0 = disabled (VPS default).
# systemd Restart=always still recovers from process crashes.
ENGINE_RESTART_SECONDS=0

# Optional Orbit-only SOCKS5 proxy (REST + WebSocket). Leave empty for
# direct access. Do not set HTTP_PROXY / HTTPS_PROXY for this.
# socks5://HOST:PORT or socks5://USER:PASS@HOST:PORT
ORBIT_SOCKS5_PROXY=

# ------------------------------------------------------------
# Betfair / Verigood valuebets feed (optional)
#
# GET https://verigood.top/valuebets every 3 seconds.
#
# Preferred auth: paste a captured browser session (DevTools on
# GET /valuebets). Do not automate login — that flow is unreliable.
#   Authorization: Bearer <jwt>
#   Cookie: sm_token=<same jwt>
# Store the jwt in BETFAIR_VALUEBETS_TOKEN and/or as Cookie, or in
# gitignored verigood_session.json.
#
# POST /api/auth/login is only a fallback when no captured session is
# present. A captured 401 never retries login.
#
# systemd: put these in the same EnvironmentFile as the other secrets
# (typically /home/woundedlion/apps/ArbScanner/.env). load_dotenv also
# reads the repo-root .env without overriding EnvironmentFile values.
# A failed Betfair auth does not stop other workers.
# ------------------------------------------------------------
BETFAIR_VALUEBETS_URL=https://verigood.top/valuebets
BETFAIR_VALUEBETS_LOGIN_URL=https://verigood.top/api/auth/login
BETFAIR_POLL_INTERVAL_SECONDS=3
BETFAIR_VALUEBETS_TOKEN=
BETFAIR_VALUEBETS_COOKIE=
# BETFAIR_VALUEBETS_SESSION_FILE=verigood_session.json

# Login fallback only (unused while TOKEN/COOKIE/session file is set).
VERIGOOD_USERNAME=
VERIGOOD_PASSWORD=

# ------------------------------------------------------------
# Kenyan bookmakers (optional -- defaults shown)
# ------------------------------------------------------------
# LIVE/PREMATCH poll interval. Stale window must outlast one uncapped
# prematch catalogue walk or the snapshot expires before it is served.
KENYAN_POLL_INTERVAL_SECONDS=5
KENYAN_STALE_AFTER_SECONDS=180
KENYAN_OPPORTUNITY_RETENTION_SECONDS=180


# ------------------------------------------------------------
# Credential store file locations (optional -- defaults shown)
# ------------------------------------------------------------
CREDENTIALS_STORE_PATH=credentials.json
CREDENTIALS_STATE_PATH=runtime/credentials_state.json
