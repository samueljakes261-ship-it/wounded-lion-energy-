# ============================================================
# ArbScanner environment configuration template.
#
# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored -- never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Credential management (see docs/CREDENTIALS.md)
# ------------------------------------------------------------

# Master encryption key used to encrypt/decrypt credentials.json.
# Generate one with:
#   .venv\Scripts\python.exe -m credentials.cli init
# NEVER commit this value. Anyone with this key can decrypt every
# credential in the encrypted store.
MASTER_CREDENTIAL_KEY=

# ------------------------------------------------------------
# ZenRows -- legacy single-credential fallback (optional)
#
# If MASTER_CREDENTIAL_KEY + credentials.json are set up, ZenRows
# credentials should be added via:
#   .venv\Scripts\python.exe -m credentials.cli add --provider zenrows --secret "wss://browser.zenrows.com?apikey=YOUR_KEY"
#
# This variable is kept as a zero-config fallback: if no zenrows
# credentials exist in the encrypted store, this single value is used
# instead so existing setups keep working without migrating.
# ------------------------------------------------------------
ZENROWS_BROWSER_WS=wss://browser.zenrows.com?apikey=YOUR_ZENROWS_API_KEY

# ------------------------------------------------------------
# Other providers referenced by experimental/legacy browser sessions.
# Not required for the current live ZenRows-based pipeline.
# ------------------------------------------------------------
SCRAPFLY_API_KEY=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# ------------------------------------------------------------
# Engine / worker tuning (all optional -- sane defaults exist)
# ------------------------------------------------------------

# Seconds after which an odds snapshot is treated as stale.
MAX_ODDS_AGE_SECONDS=30

# Arbitrage engine tick interval, in seconds.
ENGINE_TICK_SECONDS=1

# BetKanyon polling interval, in seconds.
BETKANYON_POLL_INTERVAL=3

# ------------------------------------------------------------
# Credential store file locations (optional -- defaults shown)
# ------------------------------------------------------------
CREDENTIALS_STORE_PATH=credentials.json
CREDENTIALS_STATE_PATH=runtime/credentials_state.json
