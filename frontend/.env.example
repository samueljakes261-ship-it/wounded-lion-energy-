# ============================================================
# ArbScanner frontend environment configuration template.
#
# Copy this file to `.env.local` for local development
# (`.env.local` is gitignored -- see frontend/.gitignore's `*.local`).
#
# Vite inlines every VITE_* variable into the browser bundle at BUILD
# time. Anything placed here is PUBLIC. NEVER put secrets in a VITE_*
# variable -- ZenRows API keys, MASTER_CREDENTIAL_KEY, credentials.json
# contents, or any other backend secret must stay exclusively on the
# backend/VPS (see the project root's .env.example).
# ============================================================

# Base URL of the ArbScanner backend (FastAPI) this frontend build
# should call. Must expose GET /opportunities and GET /status, and its
# CORS configuration (see api.py) must explicitly allow this frontend's
# origin.
#
# Local development (backend running via `uvicorn api:app` on your
# machine):
#   VITE_API_URL=http://localhost:8000
#
# Production (Vercel): set this as a Vercel project environment
# variable (Project Settings -> Environment Variables) to a backend URL
# that is ACTUALLY publicly reachable from the internet -- e.g. a VPS,
# Render, Railway, Fly.io deployment, etc. Vercel's browser-side build
# cannot reach `localhost` on your PC.
#
# Only use a tool like ngrok here as an explicit, temporary bridge --
# and only while the ngrok agent and the backend are both actively
# running on your machine. It is not a substitute for a real
# deployment, and Vite bakes this value in at BUILD time, so changing
# it in Vercel requires a new deployment before it takes effect.
VITE_API_URL=https://YOUR_BACKEND_URL

# Optional, opt-in: when set to "1", logs the final odds value each
# opportunity card renders, to the browser console. Never sends
# anything over the network -- purely a local debugging aid. Leave
# unset/blank in production.
VITE_ODDS_TRACE=
